<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#12201c">
<title>the place</title>
<style>
  :root {
    --bg:      #eef1ee;
    --card:    #ffffff;
    --ink:     #12201c;
    --soft:    #566761;
    --rule:    #d5dcd7;
    --accent:  #0f6b5c;
    --glow:    rgba(15,107,92,.16);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:     #0d1512;
      --card:   #16211d;
      --ink:    #e7efea;
      --soft:   #9aada6;
      --rule:   #26332e;
      --accent: #4fbfa8;
      --glow:   rgba(79,191,168,.14);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem 4rem;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main { width: 100%; max-width: 34rem; }
  header { text-align: center; margin-bottom: 2.5rem; }
  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3.1rem);
    font-weight: 600;
    letter-spacing: -.035em;
  }
  .sub {
    margin: .4rem 0 0;
    color: var(--soft);
    font-size: .95rem;
    letter-spacing: .01em;
  }
  .tiles { display: grid; gap: .9rem; }
  a.tile {
    display: grid;
    grid-template-columns: 3.25rem 1fr auto;
    align-items: center;
    gap: 0 1.1rem;
    padding: 1.15rem 1.3rem;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  a.tile:hover, a.tile:focus-visible {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 10px 28px -18px var(--glow), 0 0 0 4px var(--glow);
    outline: none;
  }
  .icon {
    width: 3.25rem; height: 3.25rem;
    display: grid; place-items: center;
    border-radius: 11px;
    background: var(--glow);
    color: var(--accent);
  }
  .icon svg { width: 1.6rem; height: 1.6rem; }
  .name { font-weight: 600; font-size: 1.06rem; letter-spacing: -.006em; }
  .desc { color: var(--soft); font-size: .875rem; }
  .chev { color: var(--soft); font-size: 1.1rem; }
  footer {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--soft);
    font-size: .8rem;
  }
</style>
</head>
<body>
<main>
  <header>
    <h1>the place</h1>
    <p class="sub">Everything running at home.</p>
  </header>

  <div class="tiles">
    <a class="tile" href="https://photos.{{ place_domain }}">
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.9a1 1 0 0 0 .83-.45l.84-1.26A1 1 0 0 1 9.9 3.8h4.2a1 1 0 0 1 .83.45l.84 1.3a1 1 0 0 0 .83.45h1.9A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5z"/>
          <circle cx="12" cy="12.2" r="3.4"/>
        </svg>
      </span>
      <span>
        <span class="name">Photos</span><br>
        <span class="desc">Our pictures and videos</span>
      </span>
      <span class="chev" aria-hidden="true">&rsaquo;</span>
    </a>
  </div>

  <footer>{{ inventory_hostname }} &middot; {{ ansible_host }}</footer>
</main>
</body>
</html>
