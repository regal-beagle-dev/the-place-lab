[Unit]
Description=Immich
Requires=docker.service
After=docker.service zfs-mount.service

# Without this, a pool that failed to mount lets Docker bind the empty
# directory underneath and write the library onto the root disk instead.
ConditionPathIsMountPoint={{ immich_library }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ immich_root }}
ExecStart=/usr/bin/docker compose up --detach --wait
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
