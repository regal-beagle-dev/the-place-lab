#!/bin/sh
# Dump the Immich database into the library, immediately before the offsite
# copy runs, so the two can never disagree. Immich's own scheduled backup is
# a setting stored inside the database it backs up; this is not.
set -eu

out="${1:?output directory}"
container="${2:?container name}"
keep="${3:-14}"

mkdir -p "$out"
stamp=$(date -u +%Y%m%dT%H%M%S)
tmp="$out/immich-db-$stamp.sql.gz.tmp"

docker exec "$container" pg_dumpall --clean --if-exists --username=postgres \
  | gzip > "$tmp"
mv "$tmp" "$out/immich-db-$stamp.sql.gz"

ls -1t "$out"/immich-db-*.sql.gz 2>/dev/null | tail -n "+$((keep + 1))" | xargs -r rm --
